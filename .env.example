# ============================================================
# DermaAgent — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your preferred LLM backend.
# Only ONE provider needs to be configured.
# ============================================================

# --- LLM Provider Selection ---
# Options: openai, qwen, groq, huggingface, ollama
# If not set, the system auto-detects from available API keys.
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini

# --- OpenAI ---
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Alibaba Qwen (DashScope) ---
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=qwen-plus

# --- Groq (Fast Inference) ---
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=llama-3.1-70b-versatile

# --- HuggingFace ---
# HUGGINGFACEHUB_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# --- Ollama (Local, no API key needed) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2

# --- Custom Model Weights ---
# Path to custom-trained MobileNetV2 weights (.pth/.pt)
# If not set, falls back to pretrained ImageNet backbone.
# DERMA_MODEL_WEIGHTS=path/to/your/model.pth
